library(ggplot2)   # must be installed
library(gridExtra) # must be installed
M <- matrix(
c(
1.00, 2.00, 1.00, 2.00,
2.00, 2.00, 1.00, 1.00,
3.00, 3.00, 2.00, 3.00
),
nrow = 3,
ncol = 4,
byrow = TRUE
)
A <- matrix(
c(
-1.00, -2.00, -1.00, -2.00,
2.00, -2.00,  1.00, -1.00,
3.00, -3.00,  2.00, -3.00
),
nrow = 3,
ncol = 4,
byrow = TRUE
)
Sigma <- matrix(
c(
1.50, 0.60, 0.24,
0.60, 1.50, 0.60,
0.24, 0.60, 1.50
),
nrow = 3,
byrow = TRUE
)
Psi <- matrix(
c(
2.151657, 1.721326, 1.377061, 1.101649,
1.721326, 2.151657, 1.721326, 1.377061,
1.377061, 1.721326, 2.151657, 1.721326,
1.101649, 1.377061, 1.721326, 2.151657
),
nrow = 4,
ncol = 4,
byrow = TRUE
)
run_mvsn_censored_boxplot_study <- function(
location_matrix,
skewness_matrix,
row_covariance_matrix,
column_covariance_matrix,
number_of_samples_vec = c(50, 100, 200, 400),
censoring_vec = c(0.05, 0.15, 0.30),
Ind_vec = c(1, 2, 3),
number_of_simulations = 200,
max_attempts = 50,
output_dir = NULL,
overwrite = TRUE,
seed = NULL
) {
# Optional seed
if (!is.null(seed)) set.seed(seed)
# Optional output folder
if (!is.null(output_dir)) {
if (!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
}
# Frobenius norm (local helper)
Frobenius_Norm <- function(A) sqrt(sum(A^2))
# MAIN storage
all_results <- list()
# Loop over all combinations
for (n in number_of_samples_vec) {
for (cens in censoring_vec) {
for (ind in Ind_vec) {
file_name <- sprintf(
"mvsnc_n%03d_c%03d_i%d.rds",
n,
as.integer(round(100 * cens)),
ind
)
if (!is.null(output_dir)) {
out_file <- file.path(output_dir, file_name)
if (!overwrite && file.exists(out_file)) {
next
}
}
cat("Running combination: n =", n,
"| cens =", cens,
"| Ind =", ind, "\n")
# ======= Box_Plot_MVSN_Censored_Data logic START =======
p <- nrow(row_covariance_matrix)
q <- ncol(column_covariance_matrix)
MVSN_Censored_M               <- array(0, dim = c(p, q, number_of_simulations))
MVSN_Censored_A               <- array(0, dim = c(p, q, number_of_simulations))
MVSN_Censored_Sigma           <- array(0, dim = c(p, p, number_of_simulations))
MVSN_Censored_Psi             <- array(0, dim = c(q, q, number_of_simulations))
Frobenius_MVSN_Censored_M     <- numeric(number_of_simulations)
Frobenius_MVSN_Censored_A     <- numeric(number_of_simulations)
Frobenius_MVSN_Censored_Sigma <- numeric(number_of_simulations)
Frobenius_MVSN_Censored_Psi   <- numeric(number_of_simulations)
MVSN_Censored_BIC             <- numeric(number_of_simulations)
MVSN_Censored_Log_Likelihood  <- numeric(number_of_simulations)
for (i in seq_len(number_of_simulations)) {
auxiliary_variable1 <- NULL
attempt <- 1
success <- FALSE
while (attempt <= max_attempts && !success) {
samples <- rmatrix_censored(
n    = n,
cens = cens,
Ind  = ind,
M    = location_matrix,
U    = row_covariance_matrix,
V    = column_covariance_matrix,
A    = skewness_matrix,
dist = "SN"
)
X.cens <- samples$X.cens
cc     <- samples$cc
LS     <- samples$LS
auxiliary_variable1 <- try(
mv_ecm(
dist = "MVSNC",
samples = X.cens,
cc = cc,
LS = LS,
precision = 1e-7,
MaxIter = 50
),
silent = TRUE
)
if (!inherits(auxiliary_variable1, "try-error")) {
success <- TRUE
} else {
attempt <- attempt + 1
}
}
if (!success) {
MVSN_Censored_M[,,i]               <- NA_real_
MVSN_Censored_A[,,i]               <- NA_real_
MVSN_Censored_Sigma[,,i]           <- NA_real_
MVSN_Censored_Psi[,,i]             <- NA_real_
Frobenius_MVSN_Censored_M[i]       <- NA_real_
Frobenius_MVSN_Censored_A[i]       <- NA_real_
Frobenius_MVSN_Censored_Sigma[i]   <- NA_real_
Frobenius_MVSN_Censored_Psi[i]     <- NA_real_
MVSN_Censored_BIC[i]               <- NA_real_
MVSN_Censored_Log_Likelihood[i]    <- NA_real_
} else {
MVSN_Censored_M[,,i]               <- auxiliary_variable1$mu
MVSN_Censored_A[,,i]               <- auxiliary_variable1$A
MVSN_Censored_Sigma[,,i]           <- auxiliary_variable1$Sigma
MVSN_Censored_Psi[,,i]             <- auxiliary_variable1$Psi
Frobenius_MVSN_Censored_M[i]       <- Frobenius_Norm(auxiliary_variable1$mu    - location_matrix)
Frobenius_MVSN_Censored_A[i]       <- Frobenius_Norm(auxiliary_variable1$A     - skewness_matrix)
Frobenius_MVSN_Censored_Sigma[i]   <- Frobenius_Norm(auxiliary_variable1$Sigma - row_covariance_matrix)
Frobenius_MVSN_Censored_Psi[i]     <- Frobenius_Norm(auxiliary_variable1$Psi   - column_covariance_matrix)
MVSN_Censored_BIC[i]               <- auxiliary_variable1$BIC
MVSN_Censored_Log_Likelihood[i]    <- auxiliary_variable1$loglik
}
}
combo_result <- list(
meta = list(
number_of_samples = n,
censoring = cens,
Ind = ind,
number_of_simulations = number_of_simulations,
max_attempts = max_attempts
),
MVSN_Censored_M               = MVSN_Censored_M,
MVSN_Censored_A               = MVSN_Censored_A,
MVSN_Censored_Sigma           = MVSN_Censored_Sigma,
MVSN_Censored_Psi             = MVSN_Censored_Psi,
Frobenius_MVSN_Censored_M     = Frobenius_MVSN_Censored_M,
Frobenius_MVSN_Censored_A     = Frobenius_MVSN_Censored_A,
Frobenius_MVSN_Censored_Sigma = Frobenius_MVSN_Censored_Sigma,
Frobenius_MVSN_Censored_Psi   = Frobenius_MVSN_Censored_Psi,
MVSN_Censored_BIC             = MVSN_Censored_BIC,
MVSN_Censored_Log_Likelihood  = MVSN_Censored_Log_Likelihood
)
# ======= Box_Plot_MVSN_Censored_Data logic END =======
key <- sprintf("mvsnc_n%03d_c%03d_i%d", n, as.integer(round(100 * cens)), ind)
all_results[[key]] <- combo_result
if (!is.null(output_dir)) {
saveRDS(combo_result, out_file)
}
}
}
}
return(all_results)
}
output <- run_mvsn_censored_boxplot_study(location_matrix = M,
skewness_matrix = A,
row_covariance_matrix = Sigma,
column_covariance_matrix = Psi,
number_of_samples_vec = c(100),
censoring_vec = c(0.30),
Ind_vec = c(2),
number_of_simulations = 100,
max_attempts = 50,
output_dir = "/media/atila/atila hd/Doutorado Pós Defesa/MVSN/mvsn_data",
overwrite = TRUE,
seed = 123)
print(output)
print(output$mvsnc_n100_c030_i2$Frobenius_MVSN_Censored_M)
median(output$mvsnc_n100_c030_i2$Frobenius_MVSN_Censored_M)
median(output$mvsnc_n100_c030_i2$Frobenius_MVSN_Censored_A)
median(output$mvsnc_n100_c030_i2$Frobenius_MVSN_Censored_Sigma)
median(output$mvsnc_n100_c030_i2$Frobenius_MVSN_Censored_Psi)
install.packages("baytrends", dependencies = TRUE)
library(baytrends)
library(dplyr)
library(MVCens)
data("dataCensored")
dataOR <- unSurvDF(dataCensored)
`%!in%` = Negate(`%in%`)
stat <- unique(dataOR$station)
vars.cens <- c("chla", "din", "nh4", "no23", "po4", "tdn", "tdp", "tn", "tp")
col.nam <- c("AP","B","BP","S")
stat.sel <- 7 # select the station
sel  <- c(2,3,5) # select the variables in vars.cens (must be sorted)
p <- length(sel) # number of variables
col.sel <- c(1,2,3,4) # select the columns in col.nam (must be sorted)
r <- length(col.sel) # number of columns
vars.sel <- character(length = length(sel))
for (i in 1:length(sel)) {
vars.sel[i] <- paste(vars.cens[sel[i]],"_lo",sep = "")
}
filt1 <- filter(dataOR, station==stat[stat.sel])
times1 <- unique(filt1$date)
elim1 <- numeric(length(times1))
for (i in 1:length(times1)) {
temp1 <- filter(filt1, date==times1[i])
if(nrow(temp1)!=r)
elim1[i] <- 1
temp2 <- select(temp1, vars.sel)
if(all(is.na(temp2)))
elim1[i] <- 1
}
times1<- times1[-which(elim1==1)]
n <- length(times1)
X.or <- array(NA, dim = c(p,r,n), dimnames = list(c(vars.cens[sel]),
c(col.nam[col.sel]),
c(1:n)))
X.cens <- X.or
cc <- LS <- array(0, dim = c(p,r,n))
for (i in 1:n) {
temp3   <- filter(filt1, date==times1[i])
temp4   <- select(temp3, vars.sel)
X.cens[,,i] <- X.or[,,i] <- t(temp4)
## Handling Missing Values (NA) ##
if(any(is.na(X.cens[,,i]))){
res0 <- which(is.na(X.cens[,,i]))
cc[,,i][res0] <- 1
LS[,,i][res0] <- +Inf
X.cens[,,i][res0] <- -Inf
}
## Handling Censoring Values ##
sel2 <- which(colnames(temp3) %in% vars.sel) # positions of the variables in temp3
for (j in 1:p) {
dif <- temp3[,sel2[j]]-temp3[,(sel2[j]+1)]
if(any(dif!=0, na.rm = T)){
res1 <- which(dif!=0)
LS[j,res1,i] <- temp3[res1,(sel2[j]+1)]
cc[j,res1,i] <- 1
}
}
}
set.seed(1234)
output_mvsnc <- mv_ecm("MVSNC", X.cens, cc, LS, precision=1e-7, MaxIter = 50)
rest.rm <- output_mvsnc
location_matrix <- rest.rm$mu + sqrt(2 / pi) * rest.rm$A
print(location_matrix)
skewness_matrix <- rest.rm$A
row_covariance_matrix <- (1 - (2 / pi)) * rest.rm$A %*% t(rest.rm$A) + sum(diag(rest.rm$Psi)) * rest.rm$Sigma
column_covariance_matrix <- (1 - (2 / pi)) * t(rest.rm$A) %*% rest.rm$A + sum(diag(rest.rm$Sigma)) * rest.rm$Psi
round(location_matrix[c(3,1,2),c(4,1,3,2)],digits = 3)
round(cov2cor(row_covariance_matrix)[c(3,1,2),c(3,1,2)],digits = 3)
devtools::document()
devtools::install()
devtools::build_manual()
