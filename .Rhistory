library(LaplacesDemon)
library(Matrix)
library(matrixNormal)
library(mnormt)
library(MomTrunc)
library(mvtnorm)
library(tlrmvnmvt)
library(MVCens)
library(MixMatrix)
library(datasets)
library(fda)
data(CanadianWeather)
Temp <- CanadianWeather$monthlyTemp
Precip <- CanadianWeather$monthlyPrecip
Temp[!is.finite(Temp)] <- NA
Precip[!is.finite(Precip)] <- NA
Temp <- apply(Temp, 2, function(x) {
x[is.na(x)] <- mean(x, na.rm = TRUE)
x
})
Precip <- apply(Precip, 2, function(x) {
x[is.na(x)] <- mean(x, na.rm = TRUE)
x
})
Precip[Precip < 0] <- 0
season_index <- list(
Winter = c(12, 1, 2),
Spring = c(3, 4, 5),
Summer = c(6, 7, 8),
Autumn = c(9, 10, 11)
)
TempSeason <- t(sapply(season_index, function(idx) {
colMeans(Temp[idx, , drop = FALSE])
}))
PrecipSeason <- t(sapply(season_index, function(idx) {
colMeans(Precip[idx, , drop = FALSE])
}))
n <- ncol(Temp)
X_array <- array(NA, dim = c(2, 4, n))
for (i in seq_len(n)) {
X_array[, , i] <- rbind(
TempSeason[, i],
PrecipSeason[, i]
)
}
X_array[!is.finite(X_array)] <- 0
rownames(X_array[, , 1]) <- c("Temperature", "Precipitation")
colnames(X_array[, , 1]) <- c("Winter", "Spring", "Summer", "Autumn")
dim(X_array)
any(!is.finite(X_array))
output_MVRSN <- mv_fit("MVRSN",
samples = X_array,
precision = 1e-6,
MaxIter = 200,
M_init,
A_init,
Sigma_init,
Psi_init)
output_MVREN <- mv_fit(model = "MVREN",
samples = X_array,
precision = 1e-6,
MaxIter = 200,
M_init,
A_init,
Sigma_init,
Psi_init,
lambda_mode = "fixed",
q_policy = "warn")
print(output_MVREN$BIC)
print(output_MVRSN$BIC)
output_MVRSN <- mv_fit("MVRSN",
samples = X_array,
precision = 1e-6,
MaxIter = 200,
M_init,
A_init,
Sigma_init,
Psi_init)
output_MVST <- mv_fit("MVST",
samples = X_array,
precision = 1e-06,
MaxIter = 200,
nu = 4,
get.nu = TRUE,
nu_bounds = c(0.05, 150))
print(output_MVST$BIC)
output_MVSN <- mv_fit("MVSN",
samples = X_array,
precision = 1e-06,
MaxIter = 200)
print(output_MVSN$BIC)
output_MVN <- mv_fit("MVN",
samples = X_array,
precision = 1e-06)
print(output_MVN$BIC)
devtools::document()
devtools::check()
devtools::document()
