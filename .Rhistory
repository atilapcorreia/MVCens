# ===============================================================
miss_summary <- df %>%
group_by(var_name, col_name) %>%
summarise(missing_count = sum(type == "missing"), .groups = "drop")
message("🧾 Missingness summary by variable and depth:")
print(miss_summary)
# ===============================================================
# --- Save, print, or return interactive plot ---
# ===============================================================
if (!is.null(save_path)) {
dir.create(dirname(save_path), showWarnings = FALSE, recursive = TRUE)
ggsave(
filename = save_path,
plot = p,
width = file_width,
height = file_height,
dpi = file_dpi
)
message(paste("✅ Figure saved to:", normalizePath(save_path)))
} else if (interactive) {
return(plotly::ggplotly(p))
} else {
print(p)
}
}
plot_censored_timeseries(df_cens,
title_text = "Temporal evolution of censored nutrient data at station CB5.4 (all variables)",
save_path  = file.path(output_dir, "Censored_All_Variables_TimeSeries.pdf"),
file_width = 11,
file_height = 6)
plot_censored_timeseries <- function(df_cens,
var_to_plot = NULL,
depth_to_plot = NULL,
title_text = "Censored data representation by variable and depth",
save_path = NULL,
file_width = 10,
file_height = 6,
file_dpi = 600) {
library(ggplot2)
library(dplyr)
df <- df_cens
# ---- Optional filtering ----
if (!is.null(var_to_plot)) {
df <- df %>% filter(var_name %in% var_to_plot)
}
if (!is.null(depth_to_plot)) {
df <- df %>% filter(col_name %in% depth_to_plot)
}
# ---- Define custom color palette ----
cols <- c(
observed = "#1B9E77",           # green
interval_censored = "#D95F02",  # orange
missing = "#7570B3",            # purple
other = "grey50"
)
# ---- Construct the plot ----
p <- ggplot(df, aes(x = date)) +
# Interval-censored values: vertical segment
geom_linerange(
data = df %>% filter(type == "interval_censored"),
aes(ymin = x_or, ymax = LS, colour = type),
alpha = 0.8,
size = 1.0
) +
# Observed points
geom_point(
data = df %>% filter(type == "observed"),
aes(y = x_or, colour = type),
size = 1.8
) +
# Missing markers at baseline
geom_point(
data = df %>% filter(type == "missing"),
aes(y = 0, colour = type),
shape = 4, size = 2.5, stroke = 0.9
) +
facet_grid(var_name ~ col_name, scales = "free_y") +
scale_colour_manual(values = cols) +
labs(
x = "Date",
y = "Concentration (original units)",
colour = "Observation Type",
title = title_text
) +
theme_bw(base_size = 12) +
theme(
# Title styling
plot.title = element_text(
hjust = 0.5, face = "bold", size = 14, margin = margin(b = 10)
),
# Axis text
axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
axis.title = element_text(face = "bold"),
# Facet strips
strip.text = element_text(face = "bold"),
strip.background = element_rect(fill = "grey92", color = "grey70"),
# Legend
legend.position = "top",
legend.title = element_text(face = "bold"),
legend.key.width = unit(1.2, "cm"),
# Grid and background
panel.grid.major = element_line(color = "grey90", linewidth = 0.3),
panel.grid.minor = element_blank(),
panel.border = element_rect(color = "grey70", fill = NA)
)
# ---- Save or print ----
if (!is.null(save_path)) {
# Create directory if necessary
dir.create(dirname(save_path), showWarnings = FALSE, recursive = TRUE)
ggsave(
filename = save_path,
plot = p,
width = file_width,
height = file_height,
dpi = file_dpi
)
message(paste("✅ Figure saved to:", normalizePath(save_path)))
} else {
print(p)
}
}
