)
# Step 2: Create the 3D array (4 quarters ? 2 columns ? 15 years)
dj_array <- array(NA, dim = c(4, 2, 15),
dimnames = list(
Quarter = paste0("Q", 1:4),
Column = c("DJ dividends", "DJ divisor"),
Year = as.character(years)
))
# Step 3: Fill the array
for (i in seq_along(years)) {
dj_array[, , i] <- dj_data[[as.character(years[i])]]
}
data.valle <- array(NA, dim = c(4, 2, 15))
for (i in seq_along(years)) {
data.valle[, , i] <- dj_data[[as.character(years[i])]]
}
mv_ecm("MVSN",
samples = data.valle,
cc = NULL, LS = NULL,
precision = 1e-7, MaxIter = 50)
library(MVCens)
M <- matrix(
c(
1.00, 2.00, 1.00, 2.00,
2.00, 2.00, 1.00, 1.00,
3.00, 3.00, 2.00, 3.00
),
nrow = 3,
ncol = 4,
byrow = TRUE
)
A <- matrix(
c(
-1.00, -2.00, -1.00, -2.00,
2.00, -2.00,  1.00, -1.00,
3.00, -3.00,  2.00, -3.00
),
nrow = 3,
ncol = 4,
byrow = TRUE
)
Sigma <- matrix(
c(
1.50, 0.60, 0.24,
0.60, 1.50, 0.60,
0.24, 0.60, 1.50
),
nrow = 3,
byrow = TRUE
)
Psi <- matrix(
c(
2.151657, 1.721326, 1.377061, 1.101649,
1.721326, 2.151657, 1.721326, 1.377061,
1.377061, 1.721326, 2.151657, 1.721326,
1.101649, 1.377061, 1.721326, 2.151657
),
nrow = 4,
ncol = 4,
byrow = TRUE
)
rmatrix_censored(n = 10, cens = 0.05, Ind = 1, M = M, U = Sigma, V = Psi, A = A, dist = "SN")
rmatrix_censored(n = 10, cens = 0.05, Ind = 1, M = M, U = Sigma, V = Psi, A = A, dist = "Normal")
rmatrix_censored(n = 15, cens = 0.05, Ind = 1, M = M, U = Sigma, V = Psi, A = A, dist = "Normal")
rmvsn(n = 15, M = M, A = A, U = Sigma, V = Psi)
samples <- rmvsn(n = 15, M = M, A = A, U = Sigma, V = Psi)
mv_ecm(dist = "MVN",
samples = samples,
cc = NULL, LS = NULL,
precision = 1e-7, MaxIter = 50)
mv_ecm(dist = "MVSN",
samples = samples,
cc = NULL, LS = NULL,
precision = 1e-7, MaxIter = 50)
samples <- rmatrix_censored(n = 15, cens = 0.05, Ind = 1, M = M, U = Sigma, V = Psi, A = A, dist = "Normal")
mv_ecm(dist = "MVNC",
samples = samples,
cc = NULL, LS = NULL,
precision = 1e-7, MaxIter = 50)
mv_ecm(dist = "MVNC",
