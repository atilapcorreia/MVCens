missing = "#56B4E9",            # Sky blue
other = "#999999"               # Neutral gray
)
# ===============================================================
# --- Dynamic subtitle summarizing selection ---
# ===============================================================
if (is.null(var_to_plot) & is.null(depth_to_plot)) {
subtitle_text <- "All variables and depths"
} else {
subtitle_text <- paste(
if (!is.null(var_to_plot)) paste("Variables:", paste(var_to_plot, collapse = ", ")),
if (!is.null(depth_to_plot)) paste("| Depths:", paste(depth_to_plot, collapse = ", ")),
sep = " "
)
}
# ===============================================================
# --- Construct main plot ---
# ===============================================================
p <- ggplot(df, aes(x = date)) +
# Interval-censored observations as vertical segments
geom_linerange(
data = df %>% filter(type == "interval_censored"),
aes(ymin = x_or, ymax = LS, colour = type),
alpha = 0.8,
linewidth = 1.0
) +
# Observed points
geom_point(
data = df %>% filter(type == "observed"),
aes(y = x_or, colour = type),
size = 2.0
) +
# Optional smoothed trend line for observed values
geom_line(
data = df %>% filter(type == "observed"),
aes(y = x_or, group = interaction(var_name, col_name)),
color = "#2E8B57",
linewidth = 0.7,
alpha = 0.6
) +
# Missing markers at baseline (y=0)
geom_point(
data = df %>% filter(type == "missing"),
aes(y = 0, colour = type),
shape = 4, size = 2.8, stroke = 1.0
) +
# Faceting by variable and depth
facet_grid(var_name ~ col_name, scales = "free_y") +
# Manual color palette
scale_colour_manual(values = cols) +
# Axis labels, title, and subtitle
labs(
x = "Date",
y = "Concentration (original units)",
colour = "Observation Type",
title = title_text,
subtitle = subtitle_text
) +
# Nice axis formatting
scale_y_continuous(labels = label_number(accuracy = 0.01)) +
# =============================================================
# --- Publication-style theme adjustments ---
# =============================================================
theme_bw(base_size = 13) +
theme(
plot.title = element_text(
hjust = 0.5, face = "bold", size = 15, margin = margin(b = 8)
),
plot.subtitle = element_text(
hjust = 0.5, size = 11, face = "italic", color = "grey25"
),
axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
axis.title = element_text(face = "bold", size = 12),
strip.text = element_text(face = "bold", size = 11),
strip.background = element_rect(fill = "grey95", color = "grey70"),
legend.position = "top",
legend.title = element_text(face = "bold"),
legend.key.width = unit(1.2, "cm"),
panel.spacing = unit(0.6, "lines"),
panel.grid.major = element_line(color = "grey92", linewidth = 0.25),
panel.border = element_rect(color = "grey60", fill = NA)
)
# ===============================================================
# --- Print summary of missing observations ---
# ===============================================================
miss_summary <- df %>%
group_by(var_name, col_name) %>%
summarise(missing_count = sum(type == "missing"), .groups = "drop")
message("🧾 Missingness summary by variable and depth:")
print(miss_summary)
# ===============================================================
# --- Save, print, or return interactive plot ---
# ===============================================================
if (!is.null(save_path)) {
dir.create(dirname(save_path), showWarnings = FALSE, recursive = TRUE)
ggsave(
filename = save_path,
plot = p,
width = file_width,
height = file_height,
dpi = file_dpi
)
message(paste("✅ Figure saved to:", normalizePath(save_path)))
} else if (interactive) {
return(plotly::ggplotly(p))
} else {
print(p)
}
}
plot_censored_timeseries <- function(df_cens,
var_to_plot = NULL,
depth_to_plot = NULL,
title_text = "Censored data representation by variable and depth",
save_path = NULL,
file_width = 10,
file_height = 6,
file_dpi = 600,
interactive = FALSE) {
# --- Load required packages ---
library(ggplot2)
library(dplyr)
library(scales)
if (interactive) {
if (!requireNamespace("plotly", quietly = TRUE)) {
stop("Package 'plotly' is required for interactive = TRUE. Please install it.")
}
}
# --- Convert input to data.frame if needed ---
df <- as.data.frame(df_cens)
# ===============================================================
# --- Optional filtering by variable or depth ---
# ===============================================================
if (!is.null(var_to_plot)) {
df <- df %>% filter(var_name %in% var_to_plot)
}
if (!is.null(depth_to_plot)) {
df <- df %>% filter(col_name %in% depth_to_plot)
}
# ===============================================================
# --- Define color-blind-friendly palette ---
# ===============================================================
cols <- c(
observed = "#2E8B57",           # Seagreen
interval_censored = "#E69F00",  # Amber/orange
missing = "#56B4E9",            # Sky blue
other = "#999999"               # Neutral gray
)
# ===============================================================
# --- Dynamic subtitle summarizing selection ---
# ===============================================================
if (is.null(var_to_plot) & is.null(depth_to_plot)) {
subtitle_text <- "All variables and depths"
} else {
subtitle_text <- paste(
if (!is.null(var_to_plot)) paste("Variables:", paste(var_to_plot, collapse = ", ")),
if (!is.null(depth_to_plot)) paste("| Depths:", paste(depth_to_plot, collapse = ", ")),
sep = " "
)
}
# ===============================================================
# --- Construct main plot ---
# ===============================================================
p <- ggplot(df, aes(x = date)) +
# Interval-censored observations as vertical segments
geom_linerange(
data = df %>% filter(type == "interval_censored"),
aes(ymin = x_or, ymax = LS, colour = type),
alpha = 0.8,
linewidth = 1.0
) +
# Observed points
geom_point(
data = df %>% filter(type == "observed"),
aes(y = x_or, colour = type),
size = 2.0
) +
# Optional smoothed trend line for observed values
geom_line(
data = df %>% filter(type == "observed"),
aes(y = x_or, group = interaction(var_name, col_name)),
color = "#2E8B57",
linewidth = 0.7,
alpha = 0.6
) +
# Missing markers at baseline (y=0)
geom_point(
data = df %>% filter(type == "missing"),
aes(y = 0, colour = type),
shape = 4, size = 2.8, stroke = 1.0
) +
# Faceting by variable and depth
facet_grid(var_name ~ col_name, scales = "free_y") +
# Manual color palette
scale_colour_manual(values = cols) +
# Axis labels, title, and subtitle
labs(
x = "Date",
y = "Concentration (original units)",
colour = "Observation Type",
title = title_text,
subtitle = subtitle_text
) +
# Nice axis formatting
scale_y_continuous(labels = label_number(accuracy = 0.01)) +
# =============================================================
# --- Publication-style theme adjustments ---
# =============================================================
theme_bw(base_size = 13) +
theme(
plot.title = element_text(
hjust = 0.5, face = "bold", size = 15, margin = margin(b = 8)
),
plot.subtitle = element_text(
hjust = 0.5, size = 11, face = "italic", color = "grey25"
),
axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
axis.title = element_text(face = "bold", size = 12),
strip.text = element_text(face = "bold", size = 11),
strip.background = element_rect(fill = "grey95", color = "grey70"),
legend.position = "top",
legend.title = element_text(face = "bold"),
legend.key.width = unit(1.2, "cm"),
panel.spacing = unit(0.6, "lines"),
panel.grid.major = element_line(color = "grey92", linewidth = 0.25),
panel.border = element_rect(color = "grey60", fill = NA)
)
# ===============================================================
# --- Print summary of missing observations ---
# ===============================================================
miss_summary <- df %>%
group_by(var_name, col_name) %>%
summarise(missing_count = sum(type == "missing"), .groups = "drop")
message("🧾 Missingness summary by variable and depth:")
print(miss_summary)
# ===============================================================
# --- Save, print, or return interactive plot ---
# ===============================================================
if (!is.null(save_path)) {
dir.create(dirname(save_path), showWarnings = FALSE, recursive = TRUE)
ggsave(
filename = save_path,
plot = p,
width = file_width,
height = file_height,
dpi = file_dpi
)
message(paste("✅ Figure saved to:", normalizePath(save_path)))
} else if (interactive) {
return(plotly::ggplotly(p))
} else {
print(p)
}
}
plot_censored_timeseries(df_cens,
title_text = "Temporal evolution of censored nutrient data at station CB5.4 (all variables)",
save_path  = file.path(output_dir, "Censored_All_Variables_TimeSeries.pdf"),
file_width = 11,
